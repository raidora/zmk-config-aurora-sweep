/*
 * BLENDER-ONLY KEYMAP
 * Left hand drives, right hand mouses and hops over to the right half
 * to type numbers (R Z 90 Enter). Letters stay where Blender expects them;
 * layers hang off hold-taps:
 *   hold Z = VIEW   hold A = MIRROR   hold Tab(T) = MODE   hold D = TIME
 * Ctrl/Shift/Alt are plain modifiers so mouse clicks register instantly.
 *
 * Blender prefs: Input > Emulate Numpad OFF. Keep NumLock ON.
 */

#include <dt-bindings/zmk/keys.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>

#define BASE 0
#define VIEW 1
#define MIRR 2
#define MODE 3
#define TIME 4
#define KEYB 5

/ {
	behaviors {
			// Layer turns on the instant the key goes down; any key pressed while
			// held uses it. Held alone and released = the letter (retro-tap).
			// Pressed right after another key (fast typing) = plain letter.
			blt: blender_layer_tap {
					compatible = "zmk,behavior-hold-tap";
					flavor = "hold-preferred";
					tapping-term-ms = <200>;
					require-prior-idle-ms = <100>;
					hold-while-undecided;
					retro-tap;
					#binding-cells = <2>;
					bindings = <&mo>, <&kp>;
			};
	};

	keymap {
		compatible = "zmk,keymap";

		/*
		 * BASE
		 *  Alt    W   E   R   Tab|MODE      Y  7  8  9  Bksp
		 *  A|MIRR S   D|TIME  F   G         H  4  5  6  -
		 *  Z|VIEW X   C   V   B             N  1  2  3  .
		 *             Ctrl  Shift          Enter|KEYB  0
		 * Right half = numeric entry; digits double as 1/2/3 select modes.
		 */
		base_layer {
			bindings = <
				&kp LALT    &kp W &kp E        &kp R     &blt MODE TAB   &kp Y &kp N7 &kp N8 &kp N9 &kp BSPC
				&blt MIRR A &kp S &blt TIME D  &kp F     &kp G          &kp H &kp N4 &kp N5 &kp N6 &kp KP_MINUS
				&blt VIEW Z &kp X &kp C        &kp V     &kp B          &kp N &kp N1 &kp N2 &kp N3 &kp DOT
				                               &kp LCTRL &kp LSHFT      &lt KEYB RET &kp N0
				>;
		};

		/*
		 * VIEW (hold Z): cube net around D = front
		 *  .  persp   TOP      local    frame all
		 *  .  LEFT    FRONT    RIGHT    BACK
		 *  #  unhide  BOTTOM   frame sel  x-ray
		 *             camera   camera to view
		 * Press Shift before Z, then a view = align view to selection.
		 */
		view_layer {
			bindings = <
				&trans &kp KP_N5     &kp KP_N7     &kp KP_SLASH &kp HOME       &trans &trans &trans &trans &trans
				&trans &kp LC(KP_N3) &kp KP_N1     &kp KP_N3    &kp LC(KP_N1)  &trans &trans &trans &trans &trans
				&trans &kp LA(H)     &kp LC(KP_N7) &kp KP_DOT   &kp LA(Z)      &trans &trans &trans &trans &trans
				                                   &kp KP_N0    &kp LC(LA(KP_N0)) &trans &trans
				>;
		};

		/*
		 * MIRROR (hold A): right-hand letters mirrored, same finger.
		 *  .  O   I   U   Y
		 *  #  L   K   J   H
		 *  .  P   ,   M   N      (P on X: the pinky is busy holding A)
		 */
		mirror_layer {
			bindings = <
				&trans &kp O &kp I     &kp U &kp Y    &trans &trans &trans &trans &trans
				&trans &kp L &kp K     &kp J &kp H    &trans &trans &trans &trans &trans
				&trans &kp P &kp COMMA &kp M &kp N    &trans &trans &trans &trans &trans
				                       &trans &trans  &trans &trans
				>;
		};

		/*
		 * MODE (hold Tab): select modes + utilities
		 *  1    2    3       .  #
		 *  Esc  F3   F9
		 *  Max  Del  .
		 *        Bksp  Enter
		 * Max = Ctrl+Space (maximize area)
		 */
		mode_layer {
			bindings = <
				&kp N1          &kp N2  &kp N3 &trans   &trans    &trans &trans &trans &trans &trans
				&kp ESC         &kp F3  &kp F9 &trans   &trans    &trans &trans &trans &trans &trans
				&kp LC(SPACE)   &kp DEL &trans &trans   &trans    &trans &trans &trans &trans &trans
				                               &kp BSPC &kp RET   &trans &trans
				>;
		};

		/*
		 * TIME (hold D): timeline under the index finger
		 *  .  Insert key  #  ◀key    key▶
		 *  .  Play           ◀frame  frame▶
		 *  .  Delete key     |◀start end▶|
		 *              (Ctrl) (Shift)
		 * Left column goes back, right column goes forward.
		 */
		time_layer {
			bindings = <
				&trans &kp I     &trans &kp DOWN      &kp UP          &trans &trans &trans &trans &trans
				&trans &kp SPACE &trans &kp LEFT      &kp RIGHT       &trans &trans &trans &trans &trans
				&trans &kp LA(I) &trans &kp LS(LEFT)  &kp LS(RIGHT)   &trans &trans &trans &trans &trans
				                        &trans        &trans          &trans &trans
				>;
		};

		/*
		 * KEYB (hold right inner thumb): Bluetooth
		 */
		keyb_layer {
			bindings = <
				&trans &trans &trans &trans &trans   &trans     &trans       &trans       &trans       &trans
				&trans &trans &trans &trans &trans   &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3
				&trans &trans &trans &trans &trans   &trans     &trans       &trans       &trans       &trans
				                     &trans &trans   &trans     &trans
				>;
		};
	};
};
